    </owl:Class>
    


    <!-- http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#IndemnisationRefusee -->

    <owl:Class rdf:about="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#IndemnisationRefusee">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#Indemnisation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/Assuarnce_et_Gestion_des_Sinistres#tauxIndemnisation"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.0</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#Indemnisation"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#IndemnisationTotale"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#IndemnisationTotale -->

    <owl:Class rdf:about="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#IndemnisationTotale">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#Indemnisation"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/Assuarnce_et_Gestion_des_Sinistres#tauxIndemnisation"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#float">100.0</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/asus/ontologies/2026/8/untitled-ontology-5#Indemnisation"/>
    </owl:Class>
    


